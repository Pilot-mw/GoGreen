# GoGreen Resources Limited — contact email system
# Copy to .env for local testing only. These values (except the real App
# Password) are configured in Netlify under Site settings > Environment
# variables. NEVER commit a real Gmail App Password.

# Gmail SMTP (authenticated sender is edkamangira@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=edkamangira@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# GoGreen receiving address
CONTACT_EMAIL=admin@gogreenmw.com

# Current production website URL
SITE_URL=https://gogreenmw.netlify.app